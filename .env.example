# Copy to .env (gitignored) and fill in. Never commit real keys.
# On Colab these same names are read from Colab secrets instead.

LITREVIEW_PROVIDER=groq          # groq | gemini | ollama
GROQ_API_KEY=
# GEMINI_API_KEY=
# S2_API_KEY=                    # optional, raises Semantic Scholar rate limits
OPENALEX_MAILTO=you@example.com  # OpenAlex "polite pool": faster, no key needed
# LITREVIEW_MODEL=groq/llama-3.3-70b-versatile
# LITREVIEW_SMALL_MODEL=groq/llama-3.1-8b-instant
# OLLAMA_BASE_URL=http://localhost:11434
